# Variables de Entorno Globales
# Copiar este archivo a .env y completar con valores específicos

# ============================================
# BASE DE DATOS (MySQL)
# ============================================
MYSQL_ROOT_PASSWORD=root_password_seguro_123!
MYSQL_DATABASE=insectos_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password_seguro_456!
MYSQL_PORT=3306
MYSQL_HOST=mysql

# ============================================
# BACKEND (Quarkus)
# ============================================
QUARKUS_PORT=8080
QUARKUS_HOSTNAME=localhost
QUARKUS_HTTP_PORT=8080
QUARKUS_PROFILE=dev
QUARKUS_LOG_LEVEL=INFO

# ============================================
# JWT
# ============================================
JWT_SECRET_KEY=tu_secret_key_muy_largo_y_seguro_aqui_cambiar_en_produccion
JWT_EXPIRATION_HOURS=24

# ============================================
# MICROSOFT ENTRA ID (OAuth2)
# ============================================
# Obtener estos valores de tu tenant de Azure
MICROSOFT_TENANT_ID=tu_tenant_id_aqui
MICROSOFT_CLIENT_ID=tu_client_id_aqui
MICROSOFT_CLIENT_SECRET=tu_client_secret_aqui

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:19000,exp://localhost:19000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# ENTORNO
# ============================================
ENVIRONMENT=dev
APP_NAME=insectos-beneficos-api
APP_VERSION=1.0.0
