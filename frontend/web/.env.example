# Variables de Entorno - Frontend Web
# Copiar este archivo a .env.local y completar con valores específicos

# ============================================
# API BACKEND
# ============================================
REACT_APP_API_BASE_URL=http://localhost:8080/api
REACT_APP_API_TIMEOUT=30000

# ============================================
# AUTENTICACIÓN
# ============================================
REACT_APP_JWT_STORAGE_KEY=insectos_jwt_token
REACT_APP_JWT_STORAGE_REFRESH_KEY=insectos_jwt_refresh

# ============================================
# MICROSOFT ENTRA ID (OAuth2)
# ============================================
REACT_APP_MICROSOFT_CLIENT_ID=tu_client_id_aqui
REACT_APP_MICROSOFT_AUTHORITY=https://login.microsoftonline.com/tu_tenant_id

# ============================================
# APLICACIÓN
# ============================================
REACT_APP_NAME=Gestión Insectos Benéficos
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# ============================================
# LOGGING Y DEBUG
# ============================================
REACT_APP_DEBUG=true
REACT_APP_LOG_LEVEL=debug
