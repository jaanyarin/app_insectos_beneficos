# Variables de Entorno - Frontend Mobile (React Native / Expo)
# Copiar este archivo a .env.local y completar con valores específicos

# ============================================
# API BACKEND
# ============================================
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
EXPO_PUBLIC_API_TIMEOUT=30000

# ============================================
# AUTENTICACIÓN
# ============================================
EXPO_PUBLIC_JWT_STORAGE_KEY=insectos_jwt_token
EXPO_PUBLIC_JWT_STORAGE_REFRESH_KEY=insectos_jwt_refresh

# ============================================
# MICROSOFT ENTRA ID (OAuth2)
# ============================================
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=tu_client_id_aqui
EXPO_PUBLIC_MICROSOFT_TENANT_ID=tu_tenant_id_aqui

# ============================================
# APLICACIÓN
# ============================================
EXPO_PUBLIC_APP_NAME=Insectos Benéficos
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_ENVIRONMENT=development

# ============================================
# EXPO
# ============================================
EXPO_PUBLIC_SCHEME=insectosbeneficos

# ============================================
# LOGGING Y DEBUG
# ============================================
EXPO_PUBLIC_DEBUG=true
EXPO_PUBLIC_LOG_LEVEL=debug
